{
  "name": "ccr-website",
  "version": "1.0.0",
  "private": true,
  "description": "CCR (Cool Case Repair) - Springfield Central QLD. Public marketing site, gated quote system, staff portal and admin AI console.",
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "npm run build:sites",
    "build:next": "npm run validate:bay && next build",
    "build:node": "npm run validate:bay && prisma generate && next build",
    "build:sites": "node scripts/build-sites.mjs",
    "build:cloudflare": "npm run build:node && opennextjs-cloudflare build --skipNextBuild",
    "preview:cloudflare": "npm run build:cloudflare && opennextjs-cloudflare preview",
    "railway:build": "npm run build:node",
    "railway:start": "prisma migrate deploy && next start -p ${PORT:-3000}",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "validate:bay": "tsx scripts/validate-bay-content.ts",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "setup": "npm run db:generate && npm run db:push && npm run db:seed"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "overrides": {
    "postcss": "$postcss",
    "sharp": "$sharp"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.93.0",
    "@neondatabase/serverless": "^0.10.4",
    "@prisma/adapter-neon": "6.19.3",
    "@prisma/adapter-pg": "6.19.3",
    "@prisma/client": "6.19.3",
    "@react-three/drei": "10.7.7",
    "@react-three/fiber": "9.6.1",
    "@types/three": "0.169.0",
    "bcryptjs": "^2.4.3",
    "clsx": "^2.1.1",
    "framer-motion": "^12.42.2",
    "jose": "^5.9.6",
    "lucide-react": "^0.462.0",
    "maath": "0.10.8",
    "next": "15.5.22",
    "nodemailer": "^9.0.3",
    "pg": "^8.23.0",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "sharp": "0.35.3",
    "tailwind-merge": "^2.6.0",
    "three": "0.169.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.14.10",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.16.5",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.15.5",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "autoprefixer": "^10.4.21",
    "eslint": "^8.57.1",
    "eslint-config-next": "15.5.22",
    "postcss": "8.5.24",
    "prisma": "6.19.3",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.2",
    "typescript": "^5.8.3",
    "wrangler": "^4.110.0"
  }
}
