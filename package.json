{
  "name": "ccr-website",
  "version": "1.0.0",
  "private": true,
  "description": "CCR (Cool Case Repair) - Springfield Central QLD. Public marketing site, gated quote system, staff portal and admin AI console.",
  "scripts": {
    "dev": "next dev",
    "build": "npm run validate:bay && next build",
    "build:sites": "npm run validate:bay && node scripts/build-sites.mjs",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "validate:bay": "tsx scripts/validate-bay-content.ts",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "setup": "npm run db:generate && npm run db:push && npm run db:seed"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.93.0",
    "@prisma/client": "^5.22.0",
    "@react-three/drei": "^9.122.0",
    "@react-three/fiber": "8.17.10",
    "@types/three": "0.169.0",
    "bcryptjs": "^2.4.3",
    "clsx": "^2.1.1",
    "framer-motion": "^12.42.2",
    "jose": "^5.9.6",
    "lucide-react": "^0.462.0",
    "maath": "0.10.8",
    "next": "^14.2.35",
    "nodemailer": "^9.0.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sharp": "^0.35.1",
    "tailwind-merge": "^2.6.0",
    "three": "0.169.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.14.10",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.16.5",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "^18.3.23",
    "@types/react-dom": "^18.3.7",
    "autoprefixer": "^10.4.21",
    "eslint": "^8.57.1",
    "eslint-config-next": "^14.2.35",
    "postcss": "^8.5.16",
    "prisma": "^5.22.0",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.2",
    "typescript": "^5.8.3",
    "wrangler": "^4.110.0"
  }
}
